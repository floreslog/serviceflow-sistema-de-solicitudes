@model ServiceFlow.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard-wrapper {
        max-width: 960px;
        margin: 0 auto;
    }

    .dashboard-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #25262a;
        margin: 0;
    }

    .dashboard-subtitle {
        font-size: 0.85rem;
        color: #9aa0a6;
        margin: 4px 0 0 0;
    }

    .stat-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid #e9ecef;
        padding: 24px 28px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        height: 100%;
    }

    .stat-label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #9aa0a6;
        margin: 0;
    }

    .stat-number {
        font-size: 2.6rem;
        font-weight: 700;
        color: #25262a;
        line-height: 1;
        margin: 4px 0;
    }

    .stat-indicator {
        font-size: 0.78rem;
        font-weight: 600;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .indicator-up {
        color: #4CAF50;
    }

    .indicator-down {
        color: #F44336;
    }

    .indicator-neutral {
        color: #9aa0a6;
    }

    .recent-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid #e9ecef;
        margin-top: 24px;
    }

    .recent-header {
        padding: 20px 24px 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #f0f0f0;
    }

    .recent-title {
        font-size: 0.85rem;
        font-weight: 700;
        color: #25262a;
        margin: 0;
    }

    .recent-link {
        font-size: 0.78rem;
        color: #9aa0a6;
        text-decoration: none;
        transition: color 0.2s ease;
    }

        .recent-link:hover {
            color: #25262a;
        }

    .recent-row {
        display: flex;
        align-items: center;
        padding: 14px 24px;
        border-bottom: 1px solid #f8f8f8;
        gap: 16px;
        text-decoration: none;
        transition: background-color 0.15s ease;
    }

        .recent-row:last-child {
            border-bottom: none;
        }

        .recent-row:hover {
            background-color: #fafafa;
        }

    .recent-id {
        font-size: 0.75rem;
        color: #9aa0a6;
        min-width: 36px;
    }

    .recent-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .recent-info {
        flex: 1;
        min-width: 0;
    }

    .recent-row-title {
        font-size: 0.875rem;
        font-weight: 600;
        color: #25262a;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin: 0;
    }

    .recent-row-meta {
        font-size: 0.75rem;
        color: #9aa0a6;
        margin: 2px 0 0 0;
    }

    .recent-badge {
        font-size: 0.7rem;
        padding: 3px 10px;
        border-radius: 20px;
        font-weight: 600;
        white-space: nowrap;
    }

    .recent-date {
        font-size: 0.75rem;
        color: #9aa0a6;
        white-space: nowrap;
    }
</style>

<div class="dashboard-wrapper">

    <div class="mb-4">
        <h1 class="dashboard-title">Panel de Control</h1>
        <p class="dashboard-subtitle">
            @DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-MX"))
        </p>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="row g-3">
            <div class="col-md-3">
                <div class="stat-card">
                    <p class="stat-label">Total</p>
                    <p class="stat-number">@Model.TotalRequests</p>
                    <p class="stat-indicator indicator-neutral">
                        solicitudes registradas
                    </p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <p class="stat-label">Abiertas</p>
                    <p class="stat-number">@Model.OpenRequests</p>
                    <p class="stat-indicator @(Model.OpenRequests > 0 ? "indicator-down" : "indicator-neutral")">
                        @(Model.OpenRequests > 0 ? "↑" : "—") sin atender
                    </p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <p class="stat-label">Resueltas</p>
                    <p class="stat-number">@Model.ResolvedRequests</p>
                    <p class="stat-indicator @(Model.ResolutionRate >= 50 ? "indicator-up" : "indicator-down")">
                        @(Model.ResolutionRate >= 50 ? "↑" : "↓") @Model.ResolutionRate% del total
                    </p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <p class="stat-label">Urgentes</p>
                    <p class="stat-number" style="color: @(Model.UrgentRequests > 0 ? "#F44336" : "#25262a");">
                        @Model.UrgentRequests
                    </p>
                    <p class="stat-indicator @(Model.UrgentRequests > 0 ? "indicator-down" : "indicator-up")">
                        @(Model.UrgentRequests > 0 ? "↑ requieren atención" : "↑ sin urgentes")
                    </p>
                </div>
            </div>
        </div>
    }
    else if (User.IsInRole("Agent"))
    {
        <div class="row g-3">
            <div class="col-md-4">
                <div class="stat-card">
                    <p class="stat-label">Asignadas</p>
                    <p class="stat-number">@Model.TotalAssignedRequests</p>
                    <p class="stat-indicator indicator-neutral">
                        en total
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <p class="stat-label">En Proceso</p>
                    <p class="stat-number" style="color: #FF9800;">@Model.InProgressRequests</p>
                    <p class="stat-indicator @(Model.AssignedRate >= 50 ? "indicator-up" : "indicator-down")">
                        @(Model.AssignedRate >= 50 ? "↑" : "↓") @Model.AssignedRate% del total
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <p class="stat-label">En Espera</p>
                    <p class="stat-number" style="color: #9aa0a6;">@Model.PendingRequests</p>
                    <p class="stat-indicator @(Model.PendingRequests > 0 ? "indicator-down" : "indicator-neutral")">
                        @(Model.PendingRequests > 0 ? "↓ pausadas" : "— ninguna en espera")
                    </p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-md-4">
                <div class="stat-card">
                    <p class="stat-label">Mis Solicitudes</p>
                    <p class="stat-number">@Model.TotalRequests</p>
                    <p class="stat-indicator indicator-neutral">
                        registradas en total
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <p class="stat-label">Abiertas</p>
                    <p class="stat-number" style="color: #2196F3;">@Model.OpenRequests</p>
                    <p class="stat-indicator @(Model.OpenRequests > 0 ? "indicator-down" : "indicator-up")">
                        @(Model.OpenRequests > 0 ? "↑ pendientes" : "— ninguna abierta")
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <p class="stat-label">Resueltas</p>
                    <p class="stat-number" style="color: #4CAF50;">@Model.ResolvedRequests</p>
                    <p class="stat-indicator @(Model.ResolutionRate >= 50 ? "indicator-up" : "indicator-down")">
                        @(Model.ResolutionRate >= 50 ? "↑" : "↓") @Model.ResolutionRate% del total
                    </p>
                </div>
            </div>
        </div>
    }

</div>