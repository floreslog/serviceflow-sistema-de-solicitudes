@model ServiceFlow.Web.ViewModels.PagedResult<ServiceFlow.Web.ViewModels.UserListViewModel>
@{
    ViewData["Title"] = "Gestión de usuarios";
    var currentFilter = ViewBag.CurrentFilter as string;
}

<style>
    .users-layout {
        display: flex;
        gap: 0;
        margin: -32px;
        min-height: calc(100vh - 60px);
    }

    .users-sidebar {
        width: 220px;
        min-width: 220px;
        background-color: #eaeef0;
        border-right: 1px solid #d8dee2;
        padding: 24px 12px;
        display: flex;
        flex-direction: column;
        gap: 20px;
        position: fixed;
        top: 0;
        left: 72px;
        height: 100vh;
        overflow-y: auto;
    }

        .users-sidebar .sidebar-section-title {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #9aa0a6;
            padding: 0 8px;
            margin-bottom: 4px;
        }

        .users-sidebar .filter-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 10px;
            border-radius: 8px;
            font-size: 0.85rem;
            color: #495057;
            text-decoration: none;
            transition: background-color 0.15s ease, color 0.15s ease;
        }

            .users-sidebar .filter-link:hover {
                background-color: #d8dee2;
                color: #25262a;
            }

            .users-sidebar .filter-link.active {
                background-color: #25262a;
                color: #ffffff;
            }

                .users-sidebar .filter-link.active .filter-count {
                    background-color: rgba(255,255,255,0.2);
                    color: #ffffff;
                }

    .filter-count {
        font-size: 0.75rem;
        background-color: #d8dee2;
        color: #495057;
        border-radius: 20px;
        padding: 1px 8px;
        font-weight: 600;
    }

    .users-main {
        flex: 1;
        padding: 28px 32px;
        overflow: auto;
        margin-left: 220px;
    }

    .users-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .users-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #25262a;
        margin: 0;
    }

    .users-subtitle {
        font-size: 0.8rem;
        color: #9aa0a6;
        margin: 2px 0 0 0;
    }

    .table thead th {
        background-color: #f8f9fa;
        color: #6c757d;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid #e9ecef;
        padding: 12px 16px;
    }

    .table tbody td {
        padding: 14px 16px;
        vertical-align: middle;
        font-size: 0.875rem;
        border-bottom: 1px solid #f0f0f0;
        color: #25262a;
    }

    .table tbody tr:hover {
        background-color: #f8f9fa;
    }
</style>

<div class="users-layout">

    <!-- SIDEBAR FILTROS -->
    <aside class="users-sidebar">
        <div>
            <p class="sidebar-section-title">Roles</p>

            <a href="@Url.Action("Index", "User")"
                   class="filter-link @(currentFilter == null ? "active" : "")">
                <span><i class="bi bi-people me-2"></i>Todos</span>
                <span class="filter-count">@ViewBag.CountAll</span>
            </a>

            <a href="@Url.Action("Index", "User", new { filter = "Admin" })"
                   class="filter-link @(currentFilter == "Admin" ? "active" : "")">
                <span><i class="bi bi-shield me-2"></i>Admin</span>
                <span class="filter-count">@ViewBag.CountAdmin</span>
            </a>

            <a href="@Url.Action("Index", "User", new { filter = "Agent" })"
                   class="filter-link @(currentFilter == "Agent" ? "active" : "")">
                <span><i class="bi bi-headset me-2"></i>Agente</span>
                <span class="filter-count">@ViewBag.CountAgent</span>
            </a>

            <a href="@Url.Action("Index", "User", new { filter = "User" })"
                   class="filter-link @(currentFilter == "User" ? "active" : "")">
                <span><i class="bi bi-person me-2"></i>Usuario</span>
                <span class="filter-count">@ViewBag.CountUser</span>
            </a>
        </div>
    </aside>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="users-main">

        <div class="users-header">
            <div>
                <h2 class="users-title">Gestión de Usuarios</h2>
                <p class="users-subtitle">@Model.TotalItems usuarios encontrados</p>
            </div>
            <form method="get" asp-controller="User" asp-action="Index" class="d-flex gap-2">
                @if (ViewBag.CurrentFilter != null)
                {
                    <input type="hidden" name="filter" value="@ViewBag.CurrentFilter" />
                }
                <input type="text" name="search" value="@ViewBag.CurrentSearch"
                       class="form-control form-control-sm"
                       placeholder="Buscar por nombre o correo..."
                       style="width: 260px;" />
                <button type="submit" class="btn btn-sm"
                        style="background-color: #25262a; color: white;">
                    <i class="bi bi-search"></i>
                </button>
                @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string))
                {
                    <a href="@Url.Action("Index", "User", new { filter = ViewBag.CurrentFilter })"
                           class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-x"></i>
                    </a>
                }
            </form>
        </div>

        @if (!Model.Items.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-people fs-1 text-muted"></i>
                <p class="text-muted mt-3">No hay usuarios para mostrar.</p>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="px-4">Nombre completo</th>
                                    <th>Email</th>
                                    <th>Rol</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.Items)
                                {
                                    <tr>
                                        <td class="px-4 fw-semibold">@user.FullName</td>
                                        <td class="text-muted">@user.Email</td>
                                        <td>
                                            @{
                                                var roleBadge = user.Role switch
                                                {
                                                    "Admin" => "bg-dark",
                                                    "Agent" => "bg-info text-dark",
                                                    "User" => "bg-secondary",
                                                    _ => "bg-light text-dark"
                                                };
                                                var roleText = user.Role switch
                                                {
                                                    "Admin" => "Admin",
                                                    "Agent" => "Agente",
                                                    "User" => "Usuario",
                                                    _ => "Sin rol"
                                                };
                                            }
                                            <span class="badge @roleBadge">@roleText</span>
                                        </td>
                                        <td>
                                            <a asp-controller="User" asp-action="Detail" asp-route-id="@user.Id"
                                                   class="btn btn-sm btn-outline-secondary me-1">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-controller="User" asp-action="Edit" asp-route-id="@user.Id"
                                                   class="btn btn-sm btn-outline-secondary me-1">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center mt-3">
                <p class="users-subtitle mb-0">
                    Página @Model.CurrentPage de @Model.TotalPages
                </p>
                <div class="d-flex gap-2">
                    @if (Model.HasPrevious)
                    {
                        <a href="@Url.Action("Index", "User", new { page = Model.CurrentPage - 1, filter = ViewBag.CurrentFilter, search = ViewBag.CurrentSearch })"
                               class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <a href="@Url.Action("Index", "User", new { page = i, filter = ViewBag.CurrentFilter, search = ViewBag.CurrentSearch })"
                               class="btn btn-sm @(i == Model.CurrentPage ? "btn-dark" : "btn-outline-secondary")">
                            @i
                        </a>
                    }

                    @if (Model.HasNext)
                    {
                        <a href="@Url.Action("Index", "User", new { page = Model.CurrentPage + 1, filter = ViewBag.CurrentFilter, search = ViewBag.CurrentSearch })"
                               class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>