@model ServiceFlow.Web.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Registro";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Crear cuenta — ServiceFlow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            height: 100%;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background: #ffffff;
        }

        .login-wrapper {
            display: flex;
            min-height: 100vh;
        }

        .login-left {
            width: 45%;
            background-color: #131317;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 60px 48px;
            position: relative;
            flex-shrink: 0;
        }

        .login-left::after {
            content: '';
            position: absolute;
            top: 0;
            right: -60px;
            width: 120px;
            height: 100%;
            background-color: #131317;
            clip-path: ellipse(60px 100% at 0% 50%);
            z-index: 2;
        }

        .login-brand {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 24px;
            text-align: center;
        }

        .login-brand img {
            width: 72px;
            height: 72px;
            filter: brightness(0) invert(1);
            opacity: 0.95;
        }

        .login-brand-name {
            font-size: 1.8rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.5px;
        }

        .login-brand-tagline {
            font-size: 0.9rem;
            color: #6c757d;
            line-height: 1.6;
            max-width: 280px;
        }

        .login-brand-divider {
            width: 40px;
            height: 2px;
            background-color: #2a2a32;
            border-radius: 2px;
            margin: 12px auto;
        }

        .login-left-footer {
            position: absolute;
            bottom: 28px;
            font-size: 0.72rem;
            color: #3a3b40;
        }

        .login-right {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 60px 48px;
            background: #ffffff;
            position: relative;
            z-index: 1;
            overflow-y: auto;
        }

        .login-form-container {
            width: 100%;
            max-width: 420px;
            padding: 20px 0;
        }

        .login-form-title {
            font-size: 1.4rem;
            font-weight: 700;
            color: #131317;
            margin-bottom: 6px;
        }

        .login-form-subtitle {
            font-size: 0.85rem;
            color: #9aa0a6;
            margin-bottom: 28px;
        }

        .form-label {
            font-size: 0.78rem;
            font-weight: 600;
            color: #495057;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 6px;
        }

        .form-control {
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 0.875rem;
            color: #25262a;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .form-control:focus {
            border-color: #131317;
            box-shadow: 0 0 0 3px rgba(19,19,23,0.08);
            outline: none;
        }

        .input-group .form-control {
            border-right: none;
            border-radius: 8px 0 0 8px;
        }

        .input-group .btn {
            border: 1px solid #e9ecef;
            border-left: none;
            border-radius: 0 8px 8px 0;
            background: #ffffff;
            color: #6c757d;
            padding: 10px 14px;
        }

        .input-group .btn:hover { background: #f8f9fa; }

        .btn-login {
            width: 100%;
            background-color: #131317;
            color: #ffffff;
            border: none;
            border-radius: 8px;
            padding: 11px;
            font-size: 0.875rem;
            font-weight: 600;
            letter-spacing: 0.03em;
            transition: background-color 0.2s ease;
            cursor: pointer;
            margin-top: 4px;
        }

        .btn-login:hover { background-color: #25262a; }

        .login-footer-links {
            margin-top: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }

        .login-footer-links a {
            font-size: 0.82rem;
            color: #9aa0a6;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .login-footer-links a:hover { color: #131317; }

        .text-danger { font-size: 0.78rem; }

        .req-item {
            font-size: 0.78rem;
            color: #6c757d;
            margin: 3px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .req-icon {
            font-size: 0.9rem;
            transition: all 0.2s ease;
        }

        .req-ok .req-icon { color: #4CAF50 !important; }
        .req-ok { color: #4CAF50; }

        #password-requirements {
            opacity: 0;
            max-height: 0;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        #password-requirements.show {
            opacity: 1;
            max-height: 200px;
        }

        @@media (max-width: 768px) {
            .login-left { display: none; }
            .login-right { padding: 40px 24px; }
        }
    </style>
</head>
<body>

<div class="login-wrapper">

    <!-- PANEL IZQUIERDO -->
    <div class="login-left">
        <div class="login-brand">
            <img src="~/images/ICON.svg" alt="ServiceFlow" />
            <div>
                <div class="login-brand-name">ServiceFlow</div>
                <div class="login-brand-divider"></div>
                <div class="login-brand-tagline">
                    Crea tu cuenta y comienza a gestionar tus solicitudes de forma eficiente.
                </div>
            </div>
        </div>
        <div class="login-left-footer">© 2026 ServiceFlow</div>
    </div>

    <!-- PANEL DERECHO -->
    <div class="login-right">
        <div class="login-form-container">

            <h1 class="login-form-title">Crear cuenta</h1>
            <p class="login-form-subtitle">Completa los campos para registrarte</p>

            <form asp-action="Register" asp-controller="Account" method="post">
                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PaternalSurname" class="form-label"></label>
                        <input asp-for="PaternalSurname" class="form-control" />
                        <span asp-validation-for="PaternalSurname" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="MaternalSurname" class="form-label"></label>
                        <input asp-for="MaternalSurname" class="form-control" />
                        <span asp-validation-for="MaternalSurname" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="correo@empresa.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Ej. 8441234567" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="mb-2">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="Password" class="form-control border-end-0" placeholder="••••••••" />
                        <button type="button" class="btn border-start-0" onclick="togglePassword('Password', this)">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div id="password-requirements" class="mb-3">
                    <p id="req-length" class="req-item">
                        <i class="bi bi-x-circle-fill req-icon text-danger"></i>
                        <span>Mínimo 8 caracteres</span>
                    </p>
                    <p id="req-upper" class="req-item">
                        <i class="bi bi-x-circle-fill req-icon text-danger"></i>
                        <span>Al menos una mayúscula</span>
                    </p>
                    <p id="req-lower" class="req-item">
                        <i class="bi bi-x-circle-fill req-icon text-danger"></i>
                        <span>Al menos una minúscula</span>
                    </p>
                    <p id="req-number" class="req-item">
                        <i class="bi bi-x-circle-fill req-icon text-danger"></i>
                        <span>Al menos un número</span>
                    </p>
                    <p id="req-special" class="req-item">
                        <i class="bi bi-x-circle-fill req-icon text-danger"></i>
                        <span>Al menos un carácter especial (@@, #, !, etc.)</span>
                    </p>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="ConfirmPassword" class="form-control border-end-0" placeholder="••••••••" />
                        <button type="button" class="btn border-start-0" onclick="togglePassword('ConfirmPassword', this)">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <button type="submit" class="btn-login">Registrarse</button>
            </form>

            <div class="login-footer-links">
                <a asp-action="Login" asp-controller="Account">¿Ya tienes cuenta? Inicia sesión</a>
            </div>

        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function togglePassword(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (input.type === "password") {
            input.type = "text";
            icon.classList.replace('bi-eye', 'bi-eye-slash');
        } else {
            input.type = "password";
            icon.classList.replace('bi-eye-slash', 'bi-eye');
        }
    }

    document.getElementById('Password').addEventListener('input', function () {
        const val = this.value;
        checkReq('req-length',  val.length >= 8);
        checkReq('req-upper',   /[A-Z]/.test(val));
        checkReq('req-lower',   /[a-z]/.test(val));
        checkReq('req-number',  /[0-9]/.test(val));
        checkReq('req-special', /[@@#!$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(val));
    });

    function checkReq(id, valid) {
        const el = document.getElementById(id);
        const icon = el.querySelector('.req-icon');
        if (valid) {
            el.classList.add('req-ok');
            icon.classList.remove('bi-x-circle-fill');
            icon.classList.add('bi-check-circle-fill');
        } else {
            el.classList.remove('req-ok');
            icon.classList.remove('bi-check-circle-fill');
            icon.classList.add('bi-x-circle-fill');
        }
    }

    const passwordInput = document.getElementById('Password');
    const requirements  = document.getElementById('password-requirements');

    passwordInput.addEventListener('focus', () => requirements.classList.add('show'));
    passwordInput.addEventListener('blur', () => {
        if (passwordInput.value.length === 0) requirements.classList.remove('show');
    });
</script>
</body>
</html>