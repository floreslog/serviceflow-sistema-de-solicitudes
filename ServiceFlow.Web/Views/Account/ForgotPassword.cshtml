@model ServiceFlow.Web.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Olvidé mi contraseña";
}

<div class="container mt-5">
    <div class="row justify-content-center w-100">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h3 class="card-title text-center mb-2">Olvidé mi contraseña</h3>
                    <p class="text-muted text-center small mb-4">
                        Ingresa tu correo y te enviaremos un código para restablecer tu contraseña.
                    </p>
                    <form asp-action="ForgotPassword" asp-controller="Account" method="post">
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>
                        <div class="text-center">
                            <button type="submit" class="btn px-5" style="background-color: #25262a; color: white;">
                                Enviar código
                            </button>
                        </div>
                    </form>
                    <hr />
                    <p class="text-center mb-0 small">
                        <a asp-action="Login" asp-controller="Account">Volver al inicio de sesión</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>