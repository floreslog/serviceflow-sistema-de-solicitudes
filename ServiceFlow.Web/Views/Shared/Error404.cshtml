@{
    ViewData["Title"] = "Página no encontrada";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>404 — ServiceFlow</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            html, body {
                height: 100%;
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
                background: #ffffff;
            }

            .wrapper {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 48px 24px;
                text-align: center;
            }

            .brand-bar {
                display: inline-flex;
                align-items: center;
                gap: 10px;
                background-color: #131317;
                padding: 10px 20px;
                border-radius: 10px;
                margin-bottom: 48px;
            }

                .brand-bar img {
                    width: 24px;
                    height: 24px;
                    filter: brightness(0) invert(1);
                }

                .brand-bar span {
                    font-size: 0.9rem;
                    font-weight: 600;
                    color: #ffffff;
                    letter-spacing: 0.02em;
                }

            .error-code {
                font-size: 7rem;
                font-weight: 800;
                color: #131317;
                line-height: 1;
                letter-spacing: -6px;
                margin-bottom: 20px;
            }

            .error-title {
                font-size: 1.3rem;
                font-weight: 700;
                color: #25262a;
                margin-bottom: 12px;
            }

            .error-desc {
                font-size: 0.875rem;
                color: #9aa0a6;
                line-height: 1.7;
                max-width: 380px;
                margin-bottom: 36px;
            }

            .btn-back {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                background-color: #131317;
                color: #ffffff;
                border: none;
                border-radius: 8px;
                padding: 11px 28px;
                font-size: 0.875rem;
                font-weight: 600;
                letter-spacing: 0.03em;
                text-decoration: none;
                transition: background-color 0.2s ease;
            }

                .btn-back:hover {
                    background-color: #25262a;
                    color: #ffffff;
                }
    </style>
</head>
<body>

    <div class="wrapper">

        <div class="brand-bar">
            <img src="~/images/ICON.svg" alt="ServiceFlow" />
            <span>ServiceFlow</span>
        </div>

        <div class="error-code">404</div>
        <h1 class="error-title">¡Ups! Parece que estás perdido.</h1>
        <p class="error-desc">
            La página que estás buscando no existe. Cómo llegaste aquí es un misterio. Pero puedes hacer clic en el botón de abajo para volver al inicio.
        </p>

        @if (User.Identity!.IsAuthenticated)
        {
            <a href="/Home/Index" class="btn-back">
                <i class="bi bi-arrow-left"></i> Volver al inicio
            </a>
        }
        else
        {
            <a href="/Account/Login" class="btn-back">
                <i class="bi bi-arrow-left"></i> Volver al inicio
            </a>
        }

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>