    padding: 16px 24px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.1);
    z-index: 9998;
    align-items: center;
    gap: 20px;
    max-width: 640px;
    width: calc(100% - 48px);">
        <span style="font-size: 2.2rem; flex-shrink: 0;">
